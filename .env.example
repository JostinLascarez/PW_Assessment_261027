# Copy this file to .env and fill in the empty values (.env is git-ignored).

# Root URL of the application under test (keep the trailing slash).
BASE_URL=https://softwaremind-assessments.s3.us-east-1.amazonaws.com/

# Demo account seeded by the application; its credentials are shown on the app's login page.
DEMO_USERNAME=
DEMO_PASSWORD=

# Every registration uses the username "<prefix><8 random characters>" and the e-mail
# "<username>@<domain>". Keep the prefix at 12 characters or fewer (the app accepts 3-20).
REGISTER_USERNAME_PREFIX=qa_
REGISTER_EMAIL_DOMAIN=example.com

# Password for registered users: any value with at least 6 characters (app rule).
REGISTER_PASSWORD=
